{
    "name": "pijler/impersonation",
    "type": "library",
    "description": "Secure user impersonation for Laravel, with per-request authorization, audit events, and session time limits.",
    "keywords": ["auth", "impersonation", "laravel", "package"],
    "license": "MIT",
    "authors": [
        {
            "name": "João Pedro Lopes",
            "email": "joaopalopes24@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "laravel/framework": "^12.0|^13.0"
    },
    "require-dev": {
        "pestphp/pest": "^4.4",
        "pestphp/pest-plugin-laravel": "^4.1",
        "orchestra/testbench": "^10.0|^11.0",
        "laravel/pint": "^1.29",
        "laravel/sanctum": "^4.3"
    },
    "autoload": {
        "psr-4": {
            "Pijler\\Impersonation\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "lint": [
            "@php vendor/bin/pint --ansi"
        ],
        "test": [
            "@php vendor/bin/pest"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Pijler\\Impersonation\\ServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable"
}
